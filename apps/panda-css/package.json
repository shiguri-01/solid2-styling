{
  "name": "panda-css",
  "version": "0.0.0",
  "description": "Solid 2.0 + Panda CSS issue tracker",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "cross-env \"PATH=$PATH\" PORTLESS_HTTPS=0 PORTLESS_SYNC_HOSTS=0 portless run --name panda-css vp dev",
    "build": "vp build",
    "serve": "vp preview",
    "prepare": "panda codegen",
    "test": "vp test",
    "lint": "vp lint ."
  },
  "dependencies": {
    "@solidjs/meta": "catalog:",
    "@solidjs/router": "catalog:",
    "@solidjs/web": "catalog:",
    "solid-js": "catalog:",
    "utils": "workspace:*"
  },
  "devDependencies": {
    "@pandacss/dev": "catalog:",
    "@pandacss/eslint-plugin": "catalog:",
    "@pandacss/preset-base": "catalog:",
    "@pandacss/preset-panda": "catalog:",
    "@pandacss/vite": "catalog:",
    "@solidjs/diagnostics": "catalog:",
    "@solidjs/testing-library": "catalog:",
    "@solidjs/vite-plugin": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "eslint-plugin-solid": "catalog:",
    "filesystem-routing": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
